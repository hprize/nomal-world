# ─── 의존성 ───────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── 빌드 산출물 ───────────────────────────
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# ─── 환경 변수 (비밀값) ─────────────────────
# .env.example 만 커밋하고 실제 값이 담긴 파일은 절대 커밋 금지
.env
.env.local
.env*.local

# ─── Turborepo / Vercel ───────────────────
.turbo/
.vercel

# ─── Supabase 로컬 (Docker) ────────────────
# supabase start 시 생성되는 로컬 전용 산출물 — 커밋 금지
# (config.toml, migrations/, seed.sql 은 커밋 대상이므로 무시하지 않음)
**/supabase/.branches/
**/supabase/.temp/
**/supabase/.env

# ─── 툴 상태 (oh-my-claudecode) ────────────
.omc/

# ─── 에디터 / IDE ─────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS 잡파일 ────────────────────────────
.DS_Store
Thumbs.db

# ─── 인증서 / 키 ──────────────────────────
*.pem

# ─── 로그 ─────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
